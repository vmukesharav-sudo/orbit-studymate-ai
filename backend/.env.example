# ORBIT - Gemini StudyMate AI Backend Configuration
PROJECT_NAME="ORBIT – Gemini StudyMate AI"
ENVIRONMENT="development" # or "production"
SECRET_KEY="orbit-super-cosmic-secret-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration
# Local Development: SQLite
DATABASE_URL="sqlite:///./orbit.db"
# Production (Render / Neon / Supabase PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/orbit_db"

# Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25

# Server Port
PORT=8000
