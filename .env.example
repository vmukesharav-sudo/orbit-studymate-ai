# ORBIT – Gemini StudyMate AI Root Configuration Example

# Backend Environment
PROJECT_NAME="ORBIT – Gemini StudyMate AI"
SECRET_KEY="orbit-super-cosmic-secret-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Database & Storage
DATABASE_URL="sqlite:///./orbit.db"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25

# Backend Port
PORT=8000

# Frontend Environment
VITE_API_URL="/api"

